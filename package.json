{
  "name": "@cryptoflops/stacks-jackpot-wall-utils",
  "version": "1.1.0",
  "description": "A decentralized jackpot wall on Stacks with real-time Chainhook integration.",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptoflops/stacks-jackpot-wall.git"
  },
  "scripts": {
    "test": "vitest run",
    "test:report": "vitest run -- --coverage --costs",
    "test:watch": "chokidar \"tests/**/*.ts\" \"contracts/**/*.clar\" -c \"npm run test:report\"",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "start:web": "npm --prefix web run start",
    "lint:web": "npm --prefix web run lint"
  },
  "author": "Stacks Builder",
  "license": "MIT",
  "dependencies": {
    "@hirosystems/chainhooks-client": "^1.0.0",
    "@stacks/clarinet-sdk": "^3.9.0",
    "@stacks/connect": "^8.2.6",
    "@stacks/transactions": "^7.2.0",
    "body-parser": "^2.2.1",
    "chokidar-cli": "^3.0.0",
    "express": "^5.2.1",
    "vitest": "^4.1.9",
    "vitest-environment-clarinet": "^3.0.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
